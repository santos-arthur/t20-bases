<div class="tab residentes flexcol {{#if ativa}}active{{/if}}" data-group="primary" data-tab="residentes">

	<ul class="item-list t20bas-bloco">
		<li class="item flexrow item-header">
			<div class="item-name flex2">{{localize "T20BAS.SecaoResidentes"}}</div>
			{{#unless aplicando}}
				<div class="item-detail"><span class="tag alerta">{{localize "T20BAS.EfeitosDesligados"}}</span></div>
			{{/unless}}
			<div class="item-controls flexrow">
				{{#if pessoas.length}}
					<a class="item-control" data-action="alternarTodos"
					   data-tooltip="{{#if algumAberto}}{{localize "T20BAS.RecolherTodos"}}{{else}}{{localize "T20BAS.ExpandirTodos"}}{{/if}}">
						<i class="fas {{#if algumAberto}}fa-compress-alt{{else}}fa-expand-alt{{/if}}"></i>
					</a>
				{{/if}}
				<a class="item-control" data-action="sincronizar"
				   data-tooltip="{{localize "T20BAS.BotaoSincronizar"}}"><i class="fas fa-arrows-rotate"></i></a>
			</div>
		</li>

		{{#if semResidentes}}
			<li class="item flexcol t20bas-nenhum">
				<i class="fas fa-users-slash"></i>
				<p><strong>{{localize "T20BAS.SemResidentes"}}</strong></p>
				<p>{{localize "T20BAS.SemResidentesDica"}}</p>
			</li>
		{{/if}}

		{{#each pessoas}}
			<li class="item flexrow t20bas-acordeon {{#if this.aberto}}aberto{{/if}}"
			    data-actor-id="{{this.actorId}}">

				<div class="item-name flexrow flex2 t20bas-cabeca" data-action="alternarPessoa"
				     data-actor-id="{{this.actorId}}">
					<i class="fas fa-chevron-right t20bas-seta noflex"></i>
					<div class="item-image noflex" style="background-image: url('{{this.img}}')"></div>
					<label>{{this.nome}}</label>
				</div>

				<div class="item-detail t20bas-contagem">
					{{#if this.automaticos.length}}
						<span class="t20bas-conta aplicado"
						      data-tooltip="{{localize "T20BAS.ContaAplicados" total=this.automaticos.length}}">
							<i class="fas fa-wand-magic-sparkles"></i>{{this.automaticos.length}}
						</span>
					{{/if}}
					{{#if this.lembretes.length}}
						<span class="t20bas-conta"
						      data-tooltip="{{localize "T20BAS.ContaLembretes" total=this.lembretes.length}}">
							<i class="fas fa-list-check"></i>{{this.lembretes.length}}
						</span>
					{{/if}}
					{{#if this.bloqueados.length}}
						<span class="t20bas-conta apagado"
						      data-tooltip="{{localize "T20BAS.ContaBloqueados" total=this.bloqueados.length}}">
							<i class="fas fa-ban"></i>{{this.bloqueados.length}}
						</span>
					{{/if}}
				</div>

				<div class="item-controls flexrow">
					{{#unless this.editavelPorMim}}
						<span class="tag" data-tooltip="{{localize "T20BAS.PrecisaMestreDica"}}"><i class="fas fa-user-shield"></i></span>
					{{/unless}}
					<a class="item-control" data-action="abrirAtor" data-actor-id="{{this.actorId}}"
					   data-tooltip="{{localize "T20BAS.AbrirFicha"}}"><i class="fas fa-address-card"></i></a>
					{{#if ../editavel}}
						<a class="item-control t20bas-excluir" data-action="removerResidente"
						   data-actor-id="{{this.actorId}}"
						   data-tooltip="{{localize "T20BAS.BotaoRemoverResidente"}}"><i class="fas fa-user-minus"></i></a>
					{{/if}}
				</div>

				<div class="item-summary">
					{{#if this.suites.length}}
						<div class="t20bas-condicoes-bloco">
							<p class="t20bas-condicoes-titulo">
								<label>{{localize "T20BAS.DormeEm"}}</label>
								<span>{{#each this.suites}}{{#unless @first}}, {{/unless}}{{this}}{{/each}}</span>
							</p>
						</div>
					{{/if}}

					{{#if this.automaticos.length}}
						<div class="t20bas-grupo aplicado">
							<p class="t20bas-grupo-titulo">
								<i class="fas fa-wand-magic-sparkles"></i>
								<label>{{localize "T20BAS.BeneficiosAplicados"}}</label>
								{{#if this.faltaSincronizar}}
									<span class="tag alerta" data-tooltip="{{localize "T20BAS.FaltaSincronizarDica"}}">
										<i class="fas fa-triangle-exclamation"></i>{{localize "T20BAS.FaltaSincronizar"}}
									</span>
								{{/if}}
							</p>
							<ul class="t20bas-beneficios">
								{{#each this.automaticos}}
									<li>
										<label>{{this.nome}}.</label> {{this.efeito}}
										{{#if this.naRolagem}}
											<span class="tag" data-tooltip="{{localize "T20BAS.MarcaRolagemDica"}}"><i class="fas fa-dice-d20"></i>{{localize "T20BAS.MarcaRolagem"}}</span>
										{{/if}}
									</li>
								{{/each}}
							</ul>
						</div>
					{{/if}}

					{{#if this.lembretes.length}}
						<div class="t20bas-grupo">
							<p class="t20bas-grupo-titulo">
								<i class="fas fa-list-check"></i>
								<label>{{localize "T20BAS.BeneficiosLembretes"}}</label>
							</p>
							<ul class="t20bas-beneficios">
								{{#each this.lembretes}}
									<li><label>{{this.nome}}.</label> {{this.efeito}}</li>
								{{/each}}
							</ul>
						</div>
					{{/if}}

					{{#if this.bloqueados.length}}
						<div class="t20bas-grupo apagado">
							<p class="t20bas-grupo-titulo">
								<i class="fas fa-ban"></i>
								<label>{{localize "T20BAS.BeneficiosBloqueados"}}</label>
							</p>
							<ul class="t20bas-beneficios">
								{{#each this.bloqueados}}
									<li><label>{{this.nome}}.</label> {{this.motivo}}</li>
								{{/each}}
							</ul>
						</div>
					{{/if}}
				</div>
			</li>
		{{/each}}
	</ul>

	{{!-- Sem ninguém para adicionar, o rodapé inteiro sai de cena. --}}
	{{#if podeAdicionar}}
		<footer class="t20bas-rodape t20bas-dar-acesso">
			<select data-campo="novoResidente">
				<option value="">{{localize "T20BAS.EscolhaPersonagem"}}</option>
				{{#each candidatos}}<option value="{{this.id}}">{{this.nome}}</option>{{/each}}
			</select>
			<button type="button" class="t20bas-acao t20bas-principal" data-action="adicionarResidente">
				<i class="fas fa-user-plus"></i> {{localize "T20BAS.BotaoAdicionarResidente"}}
			</button>
		</footer>
	{{/if}}

	<p class="t20bas-aviso"><i class="fas fa-circle-info noflex"></i> <span>{{localize "T20BAS.AvisoEstruturas"}}</span></p>
	<p class="t20bas-aviso"><i class="fas fa-circle-info noflex"></i> <span>{{localize "T20BAS.AvisoBotaoDoSistema"}}</span></p>
	<p class="t20bas-fonte">{{fonte}}</p>
</div>
