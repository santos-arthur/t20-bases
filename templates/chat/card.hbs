<div class="t20bas-card {{#if desfecho}}t20bas-card-{{desfecho}}{{/if}}">
  <header class="t20bas-card-topo">
    {{#if base.img}}<img src="{{base.img}}" alt="" />{{/if}}
    <div>
      <h3>{{titulo}}</h3>
      {{#if base.porte}}
        <span class="t20bas-card-sub">{{base.nome}} · {{localize "T20BAS.BaseDePorte" porte=base.porte}}</span>
      {{/if}}
    </div>
  </header>

  {{#if texto}}<p class="t20bas-card-texto">{{texto}}</p>{{/if}}

  {{#if linhas.length}}
    <dl class="t20bas-card-linhas">
      {{#each linhas}}
        <div><dt>{{this.rotulo}}</dt><dd>{{this.valor}}</dd></div>
      {{/each}}
    </dl>
  {{/if}}

  <footer class="t20bas-card-fonte">{{fonte}}</footer>
</div>
