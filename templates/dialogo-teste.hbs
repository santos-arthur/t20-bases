<div class="t20bas-form t20bas-fundacao">

	<p class="t20bas-fundacao-intro">{{descricao}}</p>

	{{#if caixas.length}}
		<ul class="t20bas-teste-alvo">
			{{#each caixas}}
				<li class="t20bas-alvo-item">
					<span class="t20bas-alvo-rotulo">{{this.rotulo}}</span>
					<span class="t20bas-alvo-valor">{{this.valor}}</span>
					{{#if this.nota}}<span class="t20bas-alvo-nota">{{this.nota}}</span>{{/if}}
				</li>
			{{/each}}
		</ul>
	{{/if}}

	{{#each campos}}
		<div class="form-group">
			<label>{{this.rotulo}}</label>
			<div class="form-fields">
				<select name="{{this.nome}}">
					{{#each this.opcoes}}
						<option value="{{this.valor}}" {{#if this.selecionado}}selected{{/if}}>{{this.rotulo}}</option>
					{{/each}}
				</select>
			</div>
		</div>
	{{/each}}

	{{#if temSistema}}
		<div class="form-group">
			<label>{{localize "T20BAS.CampoQuemConstroi"}}</label>
			<div class="form-fields">
				<select name="actorId">
					{{#each atores}}
						<option value="{{this.id}}" {{#if this.selecionado}}selected{{/if}}>{{this.nome}}</option>
					{{/each}}
				</select>
			</div>
		</div>

		<div class="form-group">
			<label>{{localize "T20BAS.CampoPericia"}}</label>
			<div class="form-fields">
				<select name="pericia">
					{{#each pericias}}
						<option value="{{this.key}}" {{#if this.selecionado}}selected{{/if}}>{{this.rotulo}}</option>
					{{/each}}
				</select>
			</div>
		</div>

		<p class="hint">{{localize "T20BAS.RolagemPelaFicha"}}</p>
	{{else}}
		<p class="hint">{{localize "T20BAS.AvisoSemFicha"}}</p>
		<div class="form-group">
			<label>{{localize "T20BAS.CampoBonus"}}</label>
			<div class="form-fields"><input type="number" name="bonus" value="0" /></div>
		</div>
	{{/if}}
</div>
